{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": "."
  },
  "include": [
    "config/**/*",
    "middleware/**/*",
    "utils/**/*",
    "types/**/*",
    "services/**/*",
    "models/**/*",
    "controllers/**/*",
    "routes/**/*",
    "jobs/**/*",
    "modules/**/*",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.js",
    "**/*.test.ts"
  ]
}